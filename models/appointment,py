class Appointment():
    def __init__(self, appointmentID, doctor, patient, date):
        self.appointmentID = appointmentID
        self.doctor = doctor
        self.patient = patient
        self.date = date

    def showInfo(self):
        print(f"AppointmentID:{self.appointmentID}\nDoctor:{self.doctor.name} {self.doctor.surname} \nPatient:{self.patient.name} {self.patient.surname} \nDate:{self.date}")